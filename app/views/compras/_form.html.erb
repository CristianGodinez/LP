
<%= form_with model: compra, local: true do |f| %>
<h2>SOY EL FORMULARIO DE COMPRAS</h2>
  <% if compra.errors.any? %>
    <div class="alert alert-danger">
      <h4>Errores:</h4>
      <ul>
        <% compra.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-group">
    <%= f.label :producto_id, "Producto" %>
    <%= f.collection_select :producto_id, productos, :id, :nombre, prompt: "Selecciona un producto", class: "form-control", required: true %>
  </div>

  <div class="form-group">
    <%= f.label :cantidad, "Cantidad" %>
    <%= f.number_field :cantidad, class: "form-control", required: true %>
  </div>

  <div class="form-group">
    <%= f.label :cliente, "Nombre del Cliente" %>
    <%= f.text_field :cliente, class: "form-control", required: true %>
  </div>

  <%= f.submit "Registrar Venta", class: "btn btn-success" %>
<% end %>
