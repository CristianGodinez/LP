<div class="container mt-5">
  <div class="row justify-content-center">
    <div class="col-md-6">
      <div class="card shadow-lg border-0">
        <div class="card-header bg-warning text-dark text-center">
          <h3 class="mb-0">Iniciar Sesión</h3>
        </div>
        <div class="card-body">
          <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
            <div class="form-group">
              <%= f.label :email, "Correo electrónico", class: "form-label" %>
              <%= f.email_field :email, autofocus: true, class: "form-control", placeholder: "ejemplo@correo.com" %>
            </div>

            <div class="form-group mt-3">
              <%= f.label :password, "Contraseña", class: "form-label" %>
              <%= f.password_field :password, autocomplete: "off", class: "form-control", placeholder: "********" %>
            </div>

            <% if devise_mapping.rememberable? %>
              <div class="form-check mt-3">
                <%= f.check_box :remember_me, class: "form-check-input" %>
                <%= f.label :remember_me, "Recordarme", class: "form-check-label" %>
              </div>
            <% end %>

            <div class="form-group mt-4">
              <%= f.submit "Iniciar Sesión", class: "btn btn-warning btn-block" %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
