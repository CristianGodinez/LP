<h2>Empleados</h2>
<%= link_to "Nuevo Empleado", new_empleado_path, class: "btn btn-primary mb-3" %>

<% if flash[:notice] %>
  <div class="alert alert-success">
    <%= flash[:notice] %>
  </div>
<% elsif flash[:alert] %>
  <div class="alert alert-danger">
    <%= flash[:alert] %>
  </div>
<% end %>


<table class="table table-striped">
  <thead>
    <tr>
      <th>Email</th>
      <th>Acciones</th>
    </tr>
  </thead>
  <tbody>
    <% @empleados.each do |empleado| %>
      <tr>
        <td><%= empleado.email %></td>
        <td>
          <%= link_to "Editar", edit_empleado_path(empleado), class: "btn btn-warning btn-sm" %>
          <%= button_to 'Eliminar', empleado_path(empleado), method: :delete, class: "btn btn-sm btn-danger btn-eliminar", form: { "data-message": "Esta acción eliminará al empleado y sus registros relacionados.", style: 'display: inline' } %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
