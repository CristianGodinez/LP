<nav class="navbar navbar-expand-lg navbar-dark bg-warning">
  <a class="navbar-brand" href="<%= root_path %>">Miel Cirene</a>
  <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarNav">
    <span class="navbar-toggler-icon"></span>
  </button>

  <div class="collapse navbar-collapse" id="navbarNav">
    <ul class="navbar-nav">
      <% if user_signed_in? %>
        <% if current_user.admin? %>
          <li class="nav-item">
            <%= link_to "Productos", productos_path, class: "nav-link" %>
          </li>
          <li class="nav-item">
            <%= link_to "Ventas", compras_path, class: "nav-link" %>
          </li>
          <li class="nav-item">
            <%= link_to "Reportes", reportes_path, class: "nav-link" %>
          </li>

          <li class="nav-item">
            <%= link_to "Empleados", empleados_path, class: "nav-link" %>
          </li>
        <% else %>
          <li class="nav-item">
            <%= link_to "Ventas", compras_path, class: "nav-link" %>
          </li>
        <% end %>

        <li class="nav-item">
          <%= button_to "Cerrar Sesión", destroy_user_session_path, method: :delete,
                        data: { confirm: "¿Estás seguro?" },
                        class: "nav-link btn btn-link",
                        form: { class: "d-inline" } %>
        </li>
      <% else %>
        <li class="nav-item">
          <%= link_to "Iniciar Sesión", new_user_session_path, class: "nav-link" %>
        </li>
      <% end %>
    </ul>

    <% if user_signed_in? %>
      <%= link_to perfiles_edit_path, class: "nav-link text-dark ml-auto" do %>
        Hola, <%= current_user.nombre.presence || current_user.email %>
      <% end %>
    <% end %>
    
  </div>
</nav>
