<%= form_with(model: producto, local: true, html: { class: "needs-validation" }) do |form| %>
  <% if producto.errors.any? %>
    <div class="alert alert-danger">
      <h4><%= pluralize(producto.errors.count, "error") %> impidieron guardar el producto:</h4>
      <ul>
        <% producto.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= form.label :nombre, class: "form-label" %>
    <%= form.text_field :nombre, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :descripcion, class: "form-label" %>
    <%= form.text_area :descripcion, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :precio, class: "form-label" %>
    <%= form.text_field :precio, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :stock, class: "form-label" %>
    <%= form.number_field :stock, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :imagen, "Imagen del Producto", class: "form-label" %>
    <%= form.file_field :imagen, class: "form-control" %>
    <% if producto.imagen.attached? %>
      <div class="mt-2">
        <%= image_tag producto.imagen.variant(resize_to_limit: [150, 150]), class: "img-thumbnail" %>
      </div>
    <% end %>
  </div>

  <%= form.submit "Guardar", class: "btn btn-success" %>
<% end %>
