<div class="alert alert-success text-center">
  Producto actualizado correctamente.
</div>

<div class="card shadow-sm p-4">
  <h4 class="mb-3">Detalles del producto</h4>

  <p><strong>Nombre:</strong> <%= @producto.nombre %></p>
  <p><strong>Descripción:</strong> <%= @producto.descripcion %></p>
  <p><strong>Precio:</strong> $<%= number_to_currency(@producto.precio, unit: "", separator: ".", delimiter: ",") %></p>
  <p><strong>Stock:</strong> <%= @producto.stock %></p>

  <div class="mb-3">
    <strong>Imagen:</strong><br>
    <% if @producto.imagen.attached? %>
      <%= image_tag @producto.imagen, class: "img-thumbnail", style: "max-width: 150px;" %>
    <% else %>
      <em>No hay imagen aún</em>
    <% end %>
  </div>

  <div class="d-flex justify-content-between">
    <div>
      <%= link_to 'Editar producto', edit_producto_path(@producto), class: "btn btn-outline-primary btn-sm" %>
      <%= link_to 'Volver a productos', productos_path, class: "btn btn-link btn-sm" %>
    </div>

    <%= button_to 'Eliminar producto', @producto, method: :delete, data: { confirm: '¿Estás seguro?' }, class: "btn btn-outline-danger btn-sm" %>
  </div>
</div>
